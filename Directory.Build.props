<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj_codex/**;**/bin_codex/**;**/obj_verify/**;**/bin_verify/**;**/obj_*/**;**/bin_*/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Guard against accidental compilation of generated files under obj/** -->
  <ItemGroup>
    <Compile Remove="$(BaseIntermediateOutputPath)**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="obj_codex/**/*.cs" />
    <Compile Remove="obj_verify/**/*.cs" />
    <Compile Remove="obj_*/**/*.cs" />
    <Compile Remove="bin_verify/**/*.cs" />
    <Compile Remove="bin_*/**/*.cs" />
  </ItemGroup>
</Project>
